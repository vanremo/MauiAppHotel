<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="Hotel Acordess"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource MidnightBlue}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         Padding="20"
                         Spacing="10">

        <Label Text="Cálculo da Diária"
               FontFamily="OleoScript"
               FontSize="50"
               TextColor="{StaticResource White}" />

        <Frame Padding="10">
            <VerticalStackLayout>
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*">

                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Adultos:" />

                    <Label Grid.Row="0" Grid.Column="1"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}" />

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Crianças:" />

                    <Label Grid.Row="1" Grid.Column="1"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}" />

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1" />
                </Grid>

                <Frame Padding="10" Margin="10">
                    <VerticalStackLayout>

                        <Label Text="Escolha sua Suíte"
                               TextTransform="Uppercase"
                               FontSize="Subtitle"
                               TextColor="{StaticResource Primary}"/>

                        <Picker x:Name="pck_quarto"
                                Title="Selecione sua Acomodação" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="10" Margin="10">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Período da Estadia"
                               TextTransform="Uppercase"
                               FontSize="Subtitle"
                               TextColor="{StaticResource Primary}" 
                               HorizontalOptions="Center" />    

                        <!-- Check-in e Check-out lado a lado -->
                        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                            <!-- Check-in -->
                            <VerticalStackLayout>
                                <Label Text="Check-in:" HorizontalOptions="Center"/>
                                <DatePicker x:Name="dtpck_checkin"
                            Format="dd/MM/yyyy"
                            HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <!-- Check-out -->
                            <VerticalStackLayout>
                                <Label Text="Check-out:" HorizontalOptions="Center"/>
                                <DatePicker x:Name="dtpck_checkout"
                            Format="dd/MM/yyyy"
                            HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

        <Button Text="Calcular"
        Clicked="OnCalcularClicked"
        BackgroundColor="#27AE60"
        TextColor="White"
        FontAttributes="Bold"
        Padding="10" />
            </VerticalStackLayout>
            
        </Frame>

        <Button Text="Sobre"
                Clicked="OnSobreClicked"
                BackgroundColor="#3498DB"
                TextColor="White"
                FontAttributes="Bold"
                Padding="10" />



    </VerticalStackLayout>

</ContentPage>