<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiAppHotel.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiAppHotel.Views"

    Shell.FlyoutBehavior="Disabled"
    Title="MauiAppHotel">
    
    <!-- Página de contratação de hospedagem -->
    <ShellContent
        Title="Hospedagem"
        Route="ContratacaoHospedagem"
        ContentTemplate="{DataTemplate views:ContratacaoHospedagem}" />

    <!-- Página de resultado corrigida -->
    <ShellContent Title="Resultado" Route="resultado"
              ContentTemplate="{DataTemplate views:ResultadoPage}" />
     
    <!-- Página Sobre -->
    <ShellContent
        Title="Sobre"
        Route="SobrePage"
        ContentTemplate="{DataTemplate views:SobrePage}" />

</Shell>